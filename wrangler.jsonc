{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drafttopage",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/pilot", "/pilot/*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PILOT_QUOTA", "class_name": "PilotQuota" }]
  },
  "migrations": [{ "tag": "pilot-quota-v1", "new_sqlite_classes": ["PilotQuota"] }],
  "observability": { "enabled": false }
}
