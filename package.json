{
  "name": "drafttopage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "test:contracts": "node --test tests/release-contracts.test.js",
    "benchmark:documents": "python3 scripts/browser-smoke.py --documents-only",
    "benchmark:preview-input": "node scripts/preview-input-benchmark.mjs",
    "verify:wordpress": "python3 scripts/wordpress_roundtrip.py",
    "verify:wordpress:receipt": "node scripts/verify-wordpress-receipt.mjs",
    "verify:wordpress:hosted": "node scripts/validate-hosted-wordpress-evidence.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "preflight:release": "node scripts/release-preflight.mjs",
    "preflight:release:full": "node scripts/release-preflight.mjs --require-wordpress",
    "verify:release:full": "node scripts/verify-release.mjs --require-wordpress",
    "verify:production": "node scripts/production-smoke.mjs",
    "verify:hosted:mobile": "python3 scripts/hosted_table_mobile.py",
    "verify:alpha": "node scripts/alpha-release-gate.mjs",
    "precheck": "npm run build",
    "check": "node scripts/check.mjs",
    "prepreview:mock": "npm run build",
    "preview:mock": "node scripts/preview.mjs",
    "study:plan": "node scripts/alpha-session-plan.mjs",
    "study:init": "node scripts/alpha-study.mjs init",
    "study:report": "node scripts/alpha-study.mjs report"
  }
}
